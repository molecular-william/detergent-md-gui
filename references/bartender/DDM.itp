  2  1  9      1   147.23     90.28          ; rmsd 1.43   the link's own angle
  3  1  9      1    99.02     73.19          ; rmsd 1.61
  1  2  3      1    72.16   2651.08          ; rmsd 0.66
  1  2  4      1   162.92    183.59          ; rmsd 2.52
  3  2  4      1   113.40    284.60          ; rmsd 2.17
  1  3  2      1    55.51   5420.51          ; rmsd 0.74
  2  4  5      1   124.62    244.31          ; rmsd 1.84
  2  4  6      1    90.66    105.43          ; rmsd 2.41
  5  4  6      1    52.12   1031.18          ; rmsd 1.40
  4  5  6      1    80.25   1336.81          ; rmsd 1.70
  4  6  5      1    47.39   5467.60          ; rmsd 1.03
  7  8  9      1   141.99     18.47          ; rmsd 1.04
  1  9  8      1   138.42     17.27          ; rmsd 1.55

[ dihedrals ]

; Synthetic topology for the MkVsites derivation tests.
; Two identical methyl groups (C1 and C8, both CT1, anchored to CT2 C2)
; and one hydroxyl group (O1 with H4 and the heavy C2). Distances are nm,
; angles degrees, masses g/mol. Values are exact by design so the expected
; virtual-site numbers can be computed from the paper's formulas.
[ atomtypes ]
; name at.num mass   charge ptype sigma epsilon
 CT1    6      12.0000 0.0000 A     0.0   0.0
 CT2    6      12.0000 0.0000 A     0.0   0.0
 HC     1       1.0000 0.0000 A     0.0   0.0
 OH     8      16.0000 0.0000 A     0.0   0.0
 HO     1       1.0000 0.0000 A     0.0   0.0

[ moleculetype ]
 MOL 3

[ atoms ]
; nr type resnr resid atom cgnr charge mass
    1 CT1  1 MOL C1 1 0.0 12.0
    2 HC   1 MOL H1 1 0.0  1.0
    3 HC   1 MOL H2 1 0.0  1.0
    4 HC   1 MOL H3 1 0.0  1.0
    5 CT2  1 MOL C2 1 0.0 12.0
    6 OH   1 MOL O1 1 0.0 16.0
    7 HO   1 MOL H4 1 0.0  1.0
    8 CT1  1 MOL C3 1 0.0 12.0
    9 HC   1 MOL H5 1 0.0  1.0
   10 HC   1 MOL H6 1 0.0  1.0
   11 HC   1 MOL H7 1 0.0  1.0

[ bonds ]
; ai aj funct b0 kb
   1  2 1 0.109 300000
   1  3 1 0.109 300000
   1  4 1 0.109 300000
   1  5 1 0.150 300000
   5  6 1 0.143 300000
   6  7 1 0.096 300000
   5  8 1 0.150 300000
   8  9 1 0.109 300000
   8 10 1 0.109 300000
   8 11 1 0.109 300000

[ angles ]
; ai aj ak funct theta0 ktheta
   2  1  5 1 109.4712206 400
   3  1  5 1 109.4712206 400
   4  1  5 1 109.4712206 400
   9  8  5 1 109.4712206 400
  10  8  5 1 109.4712206 400
  11  8  5 1 109.4712206 400
   5  6  7 1 108.5 400

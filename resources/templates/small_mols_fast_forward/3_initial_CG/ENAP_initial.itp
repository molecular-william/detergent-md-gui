
;;;;;; 1-ETHYLNAPHTHALENE
;
; Note(s):
;   For minimizations, you may use define=-DFLEXIBLE to use a stiff-bond version of the topology that is more amenable to minimization.
;

[ moleculetype ]
; molname    nrexcl
  ENAP         1 

[ atoms ]
; nr type resnr residue atom cgnr charge mass
   1  TC3   0    ENAP   C1    1    0     
   2  TC5   0    ENAP   R2    2    0     45   
   3  TC5   0    ENAP   R3    3    0     45   
   4  TC5   0    ENAP   R4    4    0      0
   5  TC5   0    ENAP   R5    5    0     45   
   6  TC5   0    ENAP   R6    6    0     45   

[bonds]
; i  j  funct length
  1  2   1  0.3 5000 ; C1_R2 
  1  4   1  0.3 5000 ; C1_R4
  2  3   1  0.3 5000 ; R2_R3
  2  5   1  0.3 5000 ; R2_R5
  2  6   1  0.3 5000 ; R2_R6
  3  6   1  0.3 5000 ; R3_R6
  5  6   1  0.3 5000 ; R5_R6

[ dihedrals ]
; improper
; i j k l  funct  ref.angle force_k
  1 3 6 5    2 0 10  ; C1_R3_R6_R5
  2 1 4 3    2 0 10  ; R2_C1_R4_R3
  2 3 6 5    2 0 10  ; R2_R3_R6_R5


[ virtual_sitesn ]
; site funct  constructing atom indices
   4     1     2 3 5 6 ; C2_C3_C5_C6

[ exclusions ]
 1 2 3 4 5 6
 2 3 4 5 6
 3 4 5 6
 4 5 6
 5 6

